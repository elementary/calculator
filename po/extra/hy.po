#: data/calculator.metainfo.xml.in:10
#: data/io.elementary.calculator.desktop.in:6
msgid "Calculator"
msgstr "Հաշվիչ"

#: data/calculator.metainfo.xml.in:11
#: data/io.elementary.calculator.desktop.in:7
msgid "Solve simple equations"
msgstr "Լուծեք պարզ հավասարումներ"

#: data/calculator.metainfo.xml.in:13
msgid ""
"A simple calculator for everyday use. It supports basic and some scientific "
"calculations including trigonometry functions, sin, cos, and tan."
msgstr ""
"Պարզ հաշվիչ ամենօրյա օգտագործման համար։ Աջակցում է հիմնական և որոշ գիտական "
"հաշվարկների, այդ թվում՝ եռանկյունաչափական ֆունկցիաների՝ sin, cos և tan։"

#: data/calculator.metainfo.xml.in:54
msgid "elementary, Inc."
msgstr "elementary, Inc."

#: data/calculator.metainfo.xml.in:62 data/calculator.metainfo.xml.in:72
#: data/calculator.metainfo.xml.in:81 data/calculator.metainfo.xml.in:94
#: data/calculator.metainfo.xml.in:109 data/calculator.metainfo.xml.in:120
msgid "Minor updates:"
msgstr "Փոքր թարմացումներ՝"

#: data/calculator.metainfo.xml.in:64
msgid "Replace \"Del\" button with an icon"
msgstr "«Del» կոճակը փոխարինվել է պատկերակով"

#: data/calculator.metainfo.xml.in:65 data/calculator.metainfo.xml.in:74
#: data/calculator.metainfo.xml.in:84 data/calculator.metainfo.xml.in:98
#: data/calculator.metainfo.xml.in:113 data/calculator.metainfo.xml.in:123
msgid "Updated translations"
msgstr "Թարմացված թարգմանություններ"

#: data/calculator.metainfo.xml.in:83
msgid "Branding color changed to Mint 500"
msgstr "Ապրանքանիշի գույնը փոխվել է Mint 500-ի"

#: data/calculator.metainfo.xml.in:96
msgid "Always use elementary styles and icons, even on other platforms"
msgstr ""
"Միշտ օգտագործվում են elementary-ի ոճերն ու պատկերակները, նույնիսկ այլ "
"հարթակներում"

#: data/calculator.metainfo.xml.in:97
msgid "Always paste text with the keyboard shortcut \"Ctrl + V\""
msgstr "Տեքստը միշտ տեղադրվում է «Ctrl + V» ստեղնաշարային դյուրանցմամբ"

#: data/calculator.metainfo.xml.in:111
msgid "Redesigned app icon"
msgstr "Վերաձևավորվել է հավելվածի պատկերակը"

#: data/calculator.metainfo.xml.in:112
msgid "Flat titlebar"
msgstr "Հարթ վերնագրագոտի"

#: data/calculator.metainfo.xml.in:122
msgid "Update for OS 7 and Gtk 4"
msgstr "Թարմացում OS 7-ի և Gtk 4-ի համար"

